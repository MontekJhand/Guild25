// CaesarCipher class definition
class CaesarCipher {
  private:
    int shiftValue; // Shift value for the cipher
  protected:
// Constructor to initialize shiftValue
    CaesarCipher(int value) : shiftValue(value) {}// constructor to set the shift value
  public:
// Method to set the shift value
    void setShiftValue(int value) {
      if (value >= 1 && value <= 13) {
      shiftValue = value;
    }
      else {
    printf("Invalid shift value. Please enter a value between 1 and 13.\n");
      }
      }
// Method to encode the message using Caesar cipher
string encode(const string& message) {
  string encodedMessage = message; // Copy the original message
  for (size_t i = 0; i < message.length(); ++i) {
  if (isalpha(message[i])) { // Check if the character is an alphabet
    char base = islower(message[i]) ? 'a' : 'A'; // Determine base for lowercase or uppercase
    encodedMessage[i] = (message[i] - base + shiftValue) % 26 + base; // Apply Caesar cipher
}
}
return encodedMessage; // Return the encoded message
}
// Method to decode the message using Caesar cipher


